class Patient:
    def __init__(self, name, bill_amt):
        self.__name = name
        self.__bill_amt = bill_amt

    def get_name(self):
        return self.__name

    def set_name(self, name):
        self.__name = name

    def get_bill_amt(self):
        return self.__bill_amt

    def set_bil_amt(self, bill_amt):
        self.__bill_amt = bill_amt

    def calculate_bill(self):
        return self.__bill_amt

class SeniorPatient(Patient):
    def calculate_bill(self):
        return self.get_bill_amt() * (1 - 0.20)

class PhilHealth(Patient):
    def calculate_bill(self):
        return self.get_bill_amt() * (1 - 0.15)

